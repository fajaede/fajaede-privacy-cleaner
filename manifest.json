{
  "manifest_version": 3,
  "name": "Fajaede Privacy-Cleaner",
  "version": "1.1.0",
  "description": "Fajaede Smart Browser Cleaner - Automatische en slimme browser opschoning",
  "minimum_chrome_version": "88",
  "homepage_url": "https://github.com/fajaede/fajaede-privacy-cleaner",

  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "activeTab"
  ],

  "optional_permissions": [
    "browsingData"
  ],

  "background": {
    "service_worker": "fajaede-background.js"
  },

  "action": {
    "default_popup": "fajaede-popup.html",
    "default_title": "Fajaede Privacy-Cleaner"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
